#!/data/data/com.termux/files/usr/bin/sh

CIANO='\033[1;36m'
BRANCO='\033[1;37m'
VERMELHO='\033[1;31m'
VERDE='\033[1;32m'
AMARELO='\033[1;33m'
AZUL='\033[1;34m'
RESET='\033[0m'

PASTA_SAIDA="/sdcard/Download/ScannerBySam_Completo"
mkdir -p "$PASTA_SAIDA"
RELATORIO="$PASTA_SAIDA/Relatorio_Completo_$(date +%d%m%Y_%H%M).txt"

echo -e "${CIANO}
   ███████╗ ██████╗  █████╗ ███╗   ██╗███████╗
   ██╔════╝██╔════╝ ██╔══██╗████╗  ██║██╔════╝
   ███████╗██║  ███╗███████║██╔██╗ ██║███████║
   ╚════██║██║   ██║██╔══██║██║╚██╗██║╚════██║
   ███████║╚██████╔╝██║  ██║██║ ╚████║███████║
   ╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝
${RESET}"
echo -e "${CIANO}Coded By: Sam | ACESSO TOTAL AO SISTEMA${RESET}"
echo -e "${AZUL}═══════════════════════════════════════════════════════════════${RESET}"
echo -e "${AMARELO}⚠️  ACEITE TODAS AS PERMISSÕES QUANDO SOLICITADO${RESET}"
echo -e "${AMARELO}   Com isso o scanner tem acesso completo a tudo!${RESET}"
echo -e "${AZUL}═══════════════════════════════════════════════════════════════${RESET}"
sleep 2

# CONFIRMA ACESSO E SALVA DADOS GERAIS
echo -e "\n${CIANO}📡 CONFIRMANDO ACESSO TOTAL AO SISTEMA...${RESET}"
termux-setup-storage >/dev/null 2>&1
sleep 1
echo "SCANNER BY SAM - RELATÓRIO COMPLETO" > "$RELATORIO"
echo "Data/Hora: $(date)" >> "$RELATORIO"
echo "========================================" >> "$RELATORIO"

# PEGA TODOS OS DADOS DO APARELHO
echo -e "\n${AZUL}📱 DADOS COMPLETOS DO APARELHO${RESET}"
MODELO=$(getprop ro.product.model)
MARCA=$(getprop ro.product.brand)
ANDROID=$(getprop ro.build.version.release)
BUILD=$(getprop ro.build.display.id)
SERIAL=$(getprop ro.serialno)
HWID=$(getprop ro.boot.hwid 2>/dev/null || getprop ro.hardware)
IMEI1=$(dumpsys iphonesubinfo 2>/dev/null | grep 'Device Id' | awk '{print $4}' || echo "Não disponível")
IP=$(ip -4 addr show | grep -oP '(?<=inet\s)192\.168\.\d+\.\d+' | head -1)

echo "Marca: $MARCA" >> "$RELATORIO"
echo "Modelo: $MODELO" >> "$RELATORIO"
echo "Android: $ANDROID" >> "$RELATORIO"
echo "Build: $BUILD" >> "$RELATORIO"
echo "Número de Série: $SERIAL" >> "$RELATORIO"
echo "HWID / Hardware: $HWID" >> "$RELATORIO"
echo "IP Rede: $IP" >> "$RELATORIO"

echo -e " ${BRANCO}Marca: $MARCA"
echo -e " ${BRANCO}Modelo: $MODELO"
echo -e " ${BRANCO}Android: $ANDROID"
echo -e " ${BRANCO}Nº Série: $SERIAL"
echo -e " ${BRANCO}HWID: $HWID"
echo -e " ${BRANCO}IP: $IP"

# VERIFICA ROOT E MODIFICAÇÕES
echo -e "\n${AZUL}🔐 VERIFICAÇÃO DE SISTEMA${RESET}"
if command -v su >/dev/null 2>&1 && su -c "echo OK" 2>/dev/null | grep -q "OK"; then
  echo -e " ${VERMELHO}❌ ROOT DETECTADO E ATIVO${RESET}"
  echo "IRREGULARIDADE: Root com acesso total" >> "$RELATORIO"
elif [ -d "/data/adb" ] && [ "$(ls -A /data/adb 2>/dev/null)" ]; then
  echo -e " ${VERMELHO}❌ RASTRO DE MAGISK/MODIFICAÇÃO${RESET}"
  echo "IRREGULARIDADE: Pasta /data/adb presente" >> "$RELATORIO"
else
  echo -e " ${VERDE}✅ SISTEMA ORIGINAL / SEM ROOT${RESET}"
  echo "Status: Sistema íntegro" >> "$RELATORIO"
fi

# VERIFICA FREE FIRE
echo -e "\n${AZUL}🎮 FREE FIRE - ORIGEM E INTEGRIDADE${RESET}"
verifica_ff() {
  if pm list packages | grep -q "^package:$1$"; then
    ORIGEM=$(pm list packages -i "$1" 2>/dev/null | sed -n 's/.*installer=\(.*\)/\1/p')
    if [ "$ORIGEM" = "com.android.vending" ]; then
      echo -e " ${VERDE}✅ $2: Play Store OFICIAL${RESET}"
      echo "$2: Oficial Play Store" >> "$RELATORIO"
    else
      echo -e " ${VERMELHO}❌ $2: FONTE EXTERNA - $ORIGEM${RESET}"
      echo "$2: Origem não oficial - $ORIGEM" >> "$RELATORIO"
    fi
  else
    echo -e " ${BRANCO}ℹ️ $2: Não instalado${RESET}"
    echo "$2: Não presente" >> "$RELATORIO"
  fi
}
verifica_ff com.dts.freefireth "Free Fire Normal"
verifica_ff com.dts.freefiremax "Free Fire MAX"

# RASTROS E ARQUIVOS SUSPEITOS
echo -e "\n${AZUL}🔬 RASTROS E ARQUIVOS NO SISTEMA${RESET}"
dumpsys package -u 2>/dev/null | grep -E "proxy|hack|mod|cheat|bypass|freefire" > "$PASTA_SAIDA/Desinstalados.txt"
if [ -s "$PASTA_SAIDA/Desinstalados.txt" ]; then
  echo -e " ${VERMELHO}❌ RASTROS DE APPS SUSPEITOS REMOVIDOS${RESET}"
  cat "$PASTA_SAIDA/Desinstalados.txt" | sort | uniq
  echo "DESINSTALADOS SUSPEITOS:" >> "$RELATORIO"
  cat "$PASTA_SAIDA/Desinstalados.txt" >> "$RELATORIO"
else
  echo -e " ${VERDE}✅ NENHUM RASTRO ENCONTRADO${RESET}"
fi

find /sdcard /data/local/tmp -type f \( -iname "*.apk" -o -iname "*proxy*" -o -iname "*hack*" -o -iname "*cheat*" -o -iname "*mod*ff*" \) -not -path "*/termux/*" -not -path "*/Android/data/com.dts.freefire*" 2>/dev/null > "$PASTA_SAIDA/Arquivos.txt"
if [ -s "$PASTA_SAIDA/Arquivos.txt" ]; then
  echo -e " ${VERMELHO}❌ ARQUIVOS SUSPEITOS DETECTADOS${RESET}"
  cat "$PASTA_SAIDA/Arquivos.txt"
  echo "ARQUIVOS IRREGULARES:" >> "$RELATORIO"
  cat "$PASTA_SAIDA/Arquivos.txt" >> "$RELATORIO"
else
  echo -e " ${VERDE}✅ NENHUM ARQUIVO IRREGULAR${RESET}"
fi

# FINALIZA
echo -e "\n${CIANO}═══════════════════════════════════════════════════════════════${RESET}"
echo -e "${VERDE}✅ VARREDURA CONCLUÍDA COM ACESSO TOTAL${RESET}"
echo -e "${BRANCO}📂 Relatório completo salvo em: $RELATORIO${RESET}"
echo -e "${CIANO}═══════════════════════════════════════════════════════════════${RESET}"
