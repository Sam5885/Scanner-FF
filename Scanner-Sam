#!/data/data/com.termux/files/usr/bin/sh

CIANO='\033[1;36m'; BRANCO='\033[1;37m'; VERMELHO='\033[1;31m'; VERDE='\033[1;32m'; AMARELO='\033[1;33m'; AZUL='\033[1;34m'; RESET='\033[0m'

PASTA_SAIDA="/sdcard/Download/ScannerBySam_Total"; mkdir -p "$PASTA_SAIDA"
RELATORIO="$PASTA_SAIDA/Relatorio_Acesso_Total_$(date +%d%m%Y_%H%M).txt"

while true; do
clear
echo -e "${CIANO}
██████╗  ██████╗  █████╗ ███╗   ██╗███████╗
██╔══██╗██╔════╝ ██╔══██╗████╗  ██║██╔════╝
██████╔╝██║  ███╗███████║██╔██╗ ██║███████║
██╔══██╗██║   ██║██╔══██║██║╚██╗██║╚════██║
██████╔╝╚██████╔╝██║  ██║██║ ╚████║███████║
╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝
${RESET}"
echo -e "${CIANO}Coded By: Sam | ACESSO TOTAL VIA ADB${RESET}"
echo -e "${AZUL}═══════════════════════════════════════════════════════════════${RESET}"

adb kill-server >/dev/null 2>&1; adb start-server >/dev/null 2>&1
if adb devices 2>/dev/null | grep -v List | grep -q device; then
  echo -e "${VERDE}✅ JÁ CONECTADO — INICIANDO VARREDURA${RESET}"
  sleep 1
  break
fi

echo -e "${AMARELO}⚠️  PAREAMENTO — NA ORDEM EXATA${RESET}"
echo -e "${AMARELO}   Abra: Depuração Wi‑Fi > Parear com código${RESET}"
echo -e "${AZUL}═══════════════════════════════════════════════════════════════${RESET}"

# 🔹 PRIMEIRO: PORTA DO PAREAMENTO
echo -e -n "${BRANCO}1. PORTA ABAIXO DO CÓDIGO: ${RESET}"
read P_PAR

# 🔹 SEGUNDO: CÓDIGO DE PAREAMENTO
echo -e -n "${BRANCO}2. CÓDIGO DE 6 DÍGITOS: ${RESET}"
read COD

# 🔹 TERCEIRO: IP E PORTA FINAL
echo -e -n "${BRANCO}3. IP DA TELA (ex: 192.168.0.2): ${RESET}"
read IP
echo -e -n "${BRANCO}4. PORTA DO ENDEREÇO IP: ${RESET}"
read P_CON

# ⚡ ASSIM QUE DIGITOU OS 2 PRIMEIROS, JÁ EXECUTA O PAREAMENTO
echo -e ""
echo -e "${CIANO}▶ EXECUTANDO PAREAMENTO AUTOMÁTICO: adb pair $IP:$P_PAR $COD${RESET}"
adb pair "$IP:$P_PAR" "$COD"
if [ $? -ne 0 ]; then
  echo -e "${VERMELHO}❌ FALHA NO PAREAMENTO — confira dados e tela aberta${RESET}"
  sleep 3
  continue
fi

echo -e "${VERDE}✅ PAREAMENTO FEITO — AGORA CONECTANDO...${RESET}"
adb connect "$IP:$P_CON"
if [ $? -ne 0 ]; then
  echo -e "${VERMELHO}❌ FALHA NA CONEXÃO — confira a porta${RESET}"
  sleep 3
  continue
fi

echo -e "${VERDE}✅ CONEXÃO TOTAL LIBERADA!${RESET}"
sleep 2
done

# RESTO DA VARREDURA CONTINUA IGUAL
echo "SCANNER BY SAM - RELATÓRIO" > "$RELATORIO"
echo "Data: $(date)" >> "$RELATORIO"
echo "========================================" >> "$RELATORIO"

echo -e "\n${AZUL}📱 DADOS APARELHO${RESET}"
MODELO=$(adb shell getprop ro.product.model)
MARCA=$(adb shell getprop ro.product.brand)
ANDROID=$(adb shell getprop ro.build.version.release)
SERIAL=$(adb shell getprop ro.serialno)
HWID=$(adb shell getprop ro.boot.hwid 2>/dev/null||adb shell getprop ro.hardware)

echo "Marca: $MARCA" >> "$RELATORIO"; echo "Modelo: $MODELO" >> "$RELATORIO"
echo "Android: $ANDROID" >> "$RELATORIO"; echo "Série: $SERIAL" >> "$RELATORIO"; echo "HWID: $HWID" >> "$RELATORIO"
echo -e " ${BRANCO}$MARCA | $MODELO | Android $ANDROID"
echo -e " ${BRANCO}Série: $SERIAL | HWID: $HWID"

echo -e "\n${AZUL}🔐 VERIFICAÇÃO SISTEMA${RESET}"
if adb shell su -c "echo OK" 2>/dev/null|grep -q OK; then echo -e " ${VERMELHO}❌ ROOT${RESET}"; echo "IRREGULAR: Root" >> "$RELATORIO"
elif adb shell ls /data/adb 2>/dev/null|grep -q .; then echo -e " ${VERMELHO}❌ MODIFICAÇÃO${RESET}"; echo "IRREGULAR: /data/adb" >> "$RELATORIO"
else echo -e " ${VERDE}✅ ORIGINAL${RESET}"; fi

echo -e "\n${AZUL}🎮 FREE FIRE${RESET}"
verifica_ff(){ if adb shell pm list packages 2>/dev/null|grep -q "^package:$1$"; then ORIGEM=$(adb shell pm list packages -i "$1" 2>/dev/null|sed -n 's/.*installer=\(.*\)/\1/p'); [ "$ORIGEM" = "com.android.vending" ]&&echo -e " ${VERDE}✅ $2 OFICIAL${RESET}"||echo -e " ${VERMELHO}❌ $2 EXTERNO${RESET}"; fi; }
verifica_ff com.dts.freefireth "Normal"; verifica_ff com.dts.freefiremax "MAX"

echo -e "\n${AZUL}🔬 RASTROS E LOGS${RESET}"
adb shell dumpsys package -u 2>/dev/null|grep -E "proxy|hack|mod|cheat|bypass|freefire">"$PASTA_SAIDA/Rastros.txt"||true
[ -s "$PASTA_SAIDA/Rastros.txt" ]&&echo -e " ${VERMELHO}❌ ENCONTRADOS${RESET}"||echo -e " ${VERDE}✅ NENHUM${RESET}"
adb shell logcat -d -t 60m 2>/dev/null|head -n 100>"$PASTA_SAIDA/Logs.txt"||true
adb shell bugreport --print 2>/dev/null|head -n 150>"$PASTA_SAIDA/BugReport.txt"||true
echo -e " ${BRANCO}📄 Dados salvos${RESET}"

echo -e "\n${CIANO}═══════════════════════════════════════════════════════════════${RESET}"
echo -e "${VERDE}✅ CONCLUÍDO COM ACESSO TOTAL${RESET}"
echo -e "${BRANCO}📂 Pasta: $PASTA_SAIDA${RESET}"
echo -e "${CIANO}═══════════════════════════════════════════════════════════════${RESET}"
