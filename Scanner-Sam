#!/data/data/com.termux/files/usr/bin/sh

# ==================================================
#  SCANNER BY SAM - VERSÃO FINAL FUNCIONAL
#  CORES E ESTRUTURA IGUAL AO MODELO
#  REQUER PERMISSÃO ADB PARA FUNCIONAR
# ==================================================

# DEFINIÇÃO DE CORES - EXATAMENTE IGUAL A FOTO
CIANO='\033[1;36m'
BRANCO='\033[1;37m'
VERMELHO='\033[1;31m'
VERDE='\033[1;32m'
AZUL='\033[1;34m'
RESET='\033[0m'

PASTA_SAIDA="/sdcard/Download/ScannerBySam_Relatorios"
mkdir -p "$PASTA_SAIDA"

# FUNÇÃO VERIFICAR CONEXÃO ADB
verifica_conexao() {
  adb kill-server >/dev/null 2>&1
  adb start-server >/dev/null 2>&1
  if adb devices 2>/dev/null | grep -v "List" | grep -q "device"; then
    CONECTADO=1
  else
    CONECTADO=0
  fi
}

# FUNÇÃO PRINCIPAL DE ESCANEAMENTO
iniciar_varredura() {
  TIPO="$1"
  echo -e "\n${CIANO}🔍 INICIANDO VARREDURA COMPLETA...${RESET}"
  sleep 1

  RELATORIO="$PASTA_SAIDA/Relatorio_$(date +%d%m%Y_%H%M).txt"
  echo "SCANNER BY SAM - RELATÓRIO COMPLETO" > "$RELATORIO"
  echo "Data/Hora: $(date)" >> "$RELATORIO"
  echo "Aparelho: $(getprop ro.product.model) | Android $(getprop ro.build.version.release)" >> "$RELATORIO"
  echo "========================================" >> "$RELATORIO"

  echo -e "\n${AZUL}📱 DADOS DO APARELHO${RESET}"
  echo "Modelo: $(getprop ro.product.model)" >> "$RELATORIO"
  echo "Android: $(getprop ro.build.version.release)" >> "$RELATORIO"

  echo -e "\n${AZUL}🔐 VERIFICAÇÃO DE ROOT${RESET}"
  if command -v su >/dev/null 2>&1 && su -c "echo OK" 2>/dev/null | grep -q "OK"; then
    echo -e " ${VERMELHO}❌ ROOT DETECTADO E ATIVO${RESET}"
    echo "IRREGULARIDADE: Root acessível" >> "$RELATORIO"
  elif [ -d "/data/adb" ] && [ "$(ls -A /data/adb 2>/dev/null)" ]; then
    echo -e " ${VERMELHO}❌ RASTRO DE ROOT/MODIFICAÇÃO DETECTADO${RESET}"
    echo "IRREGULARIDADE: Pasta /data/adb com arquivos" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ SEM ROOT OU MODIFICAÇÃO DETECTADA${RESET}"
    echo "Status: Sistema íntegro" >> "$RELATORIO"
  fi

  echo -e "\n${AZUL}🎮 FREE FIRE - ORIGEM E INTEGRIDADE${RESET}"
  verifica_ff() {
    if pm list packages | grep -q "^package:$1$"; then
      ORIGEM=$(pm list packages -i "$1" 2>/dev/null | sed -n 's/.*installer=\(.*\)/\1/p')
      if [ "$ORIGEM" = "com.android.vending" ]; then
        echo -e " ${VERDE}✅ $2: Instalado via Play Store (OFICIAL)${RESET}"
        echo "$2: Oficial Play Store" >> "$RELATORIO"
      else
        echo -e " ${VERMELHO}❌ $2: INSTALADO DE FONTE EXTERNA${RESET}"
        echo "$2: Origem não oficial - $ORIGEM" >> "$RELATORIO"
      fi
    else
      echo -e " ${BRANCO}ℹ️ $2: Não instalado${RESET}"
      echo "$2: Não presente no sistema" >> "$RELATORIO"
    fi
  }
  verifica_ff com.dts.freefireth "Free Fire Normal"
  verifica_ff com.dts.freefiremax "Free Fire MAX"

  echo -e "\n${AZUL}🗑️  APPS DESINSTALADOS RECENTEMENTE${RESET}"
  echo "Buscando nos últimos registros..."
  dumpsys package -u 2>/dev/null | grep -E "proxy|hack|mod|cheat|bypass|freefire" > "$PASTA_SAIDA/Desinstalados.txt"
  if [ -s "$PASTA_SAIDA/Desinstalados.txt" ]; then
    echo -e " ${VERMELHO}❌ RASTROS DE APLICATIVOS SUSPEITOS REMOVIDOS${RESET}"
    cat "$PASTA_SAIDA/Desinstalados.txt" | sort | uniq
    echo "APPS DESINSTALADOS SUSPEITOS:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Desinstalados.txt" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ NENHUM RASTRO DE APP SUSPEITO REMOVIDO${RESET}"
    echo "Desinstalações suspeitas: Nenhuma encontrada" >> "$RELATORIO"
  fi

  echo -e "\n${AZUL}📥 ACESSOS A SITES SUSPEITOS (ÚLTIMAS 24H)${RESET}"
  echo "Verificando MediaFire, downloads e fontes externas..."
  logcat -d -t 1440m 2>/dev/null | grep -i "mediafire\|anonfiles\|mod\|hack\|cheat\|freefire" > "$PASTA_SAIDA/Acessos_Suspeitos.txt"
  if [ -s "$PASTA_SAIDA/Acessos_Suspeitos.txt" ]; then
    echo -e " ${VERMELHO}❌ REGISTROS DE ACESSO DETECTADOS${RESET}"
    echo "ACESSOS NAS ÚLTIMAS 24H:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Acessos_Suspeitos.txt" | sort | uniq
  else
    echo -e " ${VERDE}✅ NENHUM ACESSO SUSPEITO NAS ÚLTIMAS 24H${RESET}"
    echo "Acessos suspeitos: Nenhum encontrado" >> "$RELATORIO"
  fi

  echo -e "\n${AZUL}🔬 VARREDURA TOTAL DE ARQUIVOS${RESET}"
  find /sdcard /data/local/tmp /data/tmp -type f \( -iname "*.apk" -o -iname "*proxy*" -o -iname "*hack*" -o -iname "*cheat*" -o -iname "*mod*freefire*" -o -iname "*bypass*" \) -not -path "*/termux/*" -not -path "*/Android/data/com.dts.freefire*" 2>/dev/null > "$PASTA_SAIDA/Arquivos_Suspeitos.txt"
  if [ -s "$PASTA_SAIDA/Arquivos_Suspeitos.txt" ]; then
    echo -e " ${VERMELHO}❌ ARQUIVOS SUSPEITOS ENCONTRADOS NO SISTEMA${RESET}"
    echo "ARQUIVOS IRREGULARES:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Arquivos_Suspeitos.txt"
  else
    echo -e " ${VERDE}✅ SISTEMA LIMPO - NENHUM ARQUIVO IRREGULAR${RESET}"
    echo "Arquivos suspeitos: Nenhum encontrado" >> "$RELATORIO"
  fi

  echo -e "\n${CIANO}========================================${RESET}"
  echo -e "${VERDE}✅ VARREDURA CONCLUÍDA COM SUCESSO${RESET}"
  echo -e "${BRANCO}📂 Relatório completo salvo em: $RELATORIO${RESET}"
  echo -e "${CIANO}========================================${RESET}"
  sleep 3
}

# ==================================================
# LOOP DO MENU PRINCIPAL
# ==================================================
while true; do
  clear
  echo -e "${CIANO}
   ███████╗ ██████╗  █████╗ ███╗   ██╗███████╗
   ██╔════╝██╔════╝ ██╔══██╗████╗  ██║██╔════╝
   ███████╗██║  ███╗███████║██╔██╗ ██║███████║
   ╚════██║██║   ██║██╔══██║██║╚██╗██║╚════██║
   ███████║╚██████╔╝██║  ██║██║ ╚████║███████║
   ╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝
${RESET}"
  echo -e "${CIANO}Coded By: Sam${RESET}"
  echo -e ""
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"
  echo -e "${AZUL}           MENU PRINCIPAL${RESET}"
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"

  verifica_conexao
  if [ $CONECTADO -eq 1 ]; then
    echo -e "ADB: ${VERDE}● Dispositivo conectado${RESET}"
  else
    echo -e "ADB: ${VERMELHO}○ Nenhum dispositivo conectado${RESET}"
  fi
  echo -e ""

  echo -e "${BRANCO}[0] Parear Dispositivo${RESET}"
  if [ $CONECTADO -eq 1 ]; then
    echo -e "${BRANCO}[1] Escanear Free Fire Normal${RESET}"
    echo -e "${BRANCO}[2] Escanear Free Fire MAX${RESET}"
    echo -e "${BRANCO}[3] Varredura Completa do Sistema${RESET}"
    echo -e "${BRANCO}[4] Salvar Relatório Completo${RESET}"
  else
    echo -e "${BRANCO}[1] Escanear Free Fire Normal ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[2] Escanear Free Fire MAX     ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[3] Varredura Completa          ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[4] Salvar Relatório            ${VERMELHO}(pareie primeiro)${RESET}"
  fi
  echo -e "${BRANCO}[S] Sair${RESET}"
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"
  echo -e -n "${BRANCO}Escolha uma opção: ${RESET}"
  read OPCAO

  case "$OPCAO" in
    0)
      clear
      echo -e "${CIANO}════════════ PAREAMENTO DEPURAÇÃO WI-FI ════════════${RESET}"
      echo -e "${VERMELHO}⚠️  ACEITE A PERMISSÃO DE DEPURAÇÃO NA TELA${RESET}"
      echo -e "   Marque 'Sempre permitir' e toque em PERMITIR"
      echo -e -n "   Aperte ENTER quando aceitar: "
      read _
      echo -e ""
      echo -e "${BRANCO}1. Digite a PORTA logo ABAIXO do código de pareamento: ${RESET}"
      read P_PAR
      echo -e "${BRANCO}2. Digite o CÓDIGO DE 6 DÍGITOS: ${RESET}"
      read CODIGO
      echo -e "${BRANCO}3. Digite a PORTA do campo 'Endereço IP e porta': ${RESET}"
      read P_CON
      echo -e ""
      IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
      if [ -z "$IP" ]; then
        echo -e "${VERMELHO}❌ SEM WI-FI CONECTADO!${RESET}"
        sleep 2
        continue
      fi
      echo -e "${CIANO}🔗 Executando pareamento: adb pair $IP:$P_PAR $CODIGO${RESET}"
      adb pair "$IP:$P_PAR" "$CODIGO"
      sleep 1
      echo -e "${CIANO}🔌 Conectando na porta $P_CON...${RESET}"
      adb connect "$IP:$P_CON"
      sleep 1
      verifica_conexao
      if [ $CONECTADO -eq 1 ]; then
        echo -e "${VERDE}✅ PAREAMENTO E CONEXÃO BEM SUCEDIDOS!${RESET}"
      else
        echo -e "${VERMELHO}❌ FALHA NA CONEXÃO - Confira dados/rede${RESET}"
      fi
      sleep 2
    ;;

    1)
      if [ $CONECTADO -eq 0 ]; then
        echo -e "\n${VERMELHO}❌ PRIMEIRO PAREE O DISPOSITIVO NA OPÇÃO [0]${RESET}"
        sleep 2
        continue
      fi
      iniciar_varredura "FF_NORMAL"
    ;;

    2)
      if [ $CONECTADO -eq 0 ]; then
        echo -e "\n${VERMELHO}❌ PRIMEIRO PAREE O DISPOSITIVO NA OPÇÃO [0]${RESET}"
        sleep 2
        continue
      fi
      iniciar_varredura "FF_MAX"
    ;;

    3|4)
      if [ $CONECTADO -eq 0 ]; then
        echo -e "\n${VERMELHO}❌ PRIMEIRO PAREE O DISPOSITIVO NA OPÇÃO [0]${RESET}"
        sleep 2
        continue
      fi
      iniciar_varredura "COMPLETA"
    ;;

    S|s)
      clear
      echo -e "${VERDE}✅ Encerrando Scanner By Sam...${RESET}"
      adb kill-server >/dev/null 2>&1
      exit 0
    ;;

    *)
      echo -e "\n${VERMELHO}❌ OPÇÃO INVÁLIDA!${RESET}"
      sleep 1
    ;;
  esac
done
