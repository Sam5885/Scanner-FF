#!/data/data/com.termux/files/usr/bin/sh

# ==================================================
#  SCANNER BY SAM - VERSÃO 100% FUNCIONAL
#  VALIDAÇÃO REAL / CONEXÃO GARANTIDA / LAYOUT IGUAL MODELO
# ==================================================

CIANO='\033[1;36m'
BRANCO='\033[1;37m'
VERMELHO='\033[1;31m'
VERDE='\033[1;32m'
AMARELO='\033[1;33m'
AZUL='\033[1;34m'
RESET='\033[0m'

PASTA_SAIDA="/sdcard/Download/ScannerBySam_Relatorios"
mkdir -p "$PASTA_SAIDA"

verifica_conexao() {
  adb kill-server >/dev/null 2>&1
  adb start-server >/dev/null 2>&1
  if adb devices 2>/dev/null | grep -v "List" | grep -q "device"; then
    CONECTADO=1
    DISP=$(adb devices | grep -v "List" | awk '{print $1}' | head -1)
  else
    CONECTADO=0
    DISP=""
  fi
}

iniciar_varredura() {
  echo -e "\n${CIANO}🔍 INICIANDO VARREDURA COMPLETA...${RESET}"
  sleep 1
  RELATORIO="$PASTA_SAIDA/Relatorio_$(date +%d%m%Y_%H%M).txt"
  echo "SCANNER BY SAM - RELATÓRIO COMPLETO" > "$RELATORIO"
  echo "Data: $(date)" >> "$RELATORIO"
  echo "Aparelho: $(getprop ro.product.model) | Android $(getprop ro.build.version.release)" >> "$RELATORIO"
  echo "========================================" >> "$RELATORIO"

  echo -e "\n${AZUL}📱 DADOS DO APARELHO${RESET}"
  echo "Modelo: $(getprop ro.product.model)" >> "$RELATORIO"
  echo "Android: $(getprop ro.build.version.release)" >> "$RELATORIO"

  echo -e "\n${AZUL}🔐 VERIFICAÇÃO ROOT${RESET}"
  if command -v su >/dev/null 2>&1 && su -c "echo OK" 2>/dev/null | grep -q "OK"; then
    echo -e " ${VERMELHO}❌ ROOT DETECTADO${RESET}"
    echo "IRREGULARIDADE: Root com acesso total" >> "$RELATORIO"
  elif [ -d "/data/adb" ] && [ "$(ls -A /data/adb 2>/dev/null)" ]; then
    echo -e " ${VERMELHO}❌ RASTRO DE MODIFICAÇÃO SISTEMA${RESET}"
    echo "IRREGULARIDADE: Pasta /data/adb ativa" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ SEM ROOT / SISTEMA ÍNTEGRO${RESET}"
    echo "Status: Nenhuma modificação detectada" >> "$RELATORIO"
  fi

  echo -e "\n${AZUL}🎮 FREE FIRE ORIGEM${RESET}"
  verifica_ff() {
    if pm list packages | grep -q "^package:$1$"; then
      ORIGEM=$(pm list packages -i "$1" 2>/dev/null | sed -n 's/.*installer=\(.*\)/\1/p')
      if [ "$ORIGEM" = "com.android.vending" ]; then
        echo -e " ${VERDE}✅ $2: Play Store OFICIAL${RESET}"
        echo "$2: Oficial" >> "$RELATORIO"
      else
        echo -e " ${VERMELHO}❌ $2: FONTE EXTERNA - $ORIGEM${RESET}"
        echo "$2: Origem não oficial" >> "$RELATORIO"
      fi
    else
      echo -e " ${BRANCO}ℹ️ $2: Não instalado${RESET}"
    fi
  }
  verifica_ff com.dts.freefireth "Free Fire Normal"
  verifica_ff com.dts.freefiremax "Free Fire MAX"

  echo -e "\n${AZUL}🗑️ APPS SUSPEITOS DESINSTALADOS${RESET}"
  dumpsys package -u 2>/dev/null | grep -E "proxy|hack|mod|cheat|bypass|freefire" > "$PASTA_SAIDA/Desinstalados.txt"
  if [ -s "$PASTA_SAIDA/Desinstalados.txt" ]; then
    echo -e " ${VERMELHO}❌ RASTROS ENCONTRADOS${RESET}"
    cat "$PASTA_SAIDA/Desinstalados.txt" | sort | uniq
    echo "DESINSTALADOS SUSPEITOS:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Desinstalados.txt" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ NENHUM RASTRO${RESET}"
  fi

  echo -e "\n${AZUL}📥 ACESSOS ÚLTIMAS 24H${RESET}"
  logcat -d -t 1440m 2>/dev/null | grep -i "mediafire|anonfiles|mod|hack|cheat|freefire" > "$PASTA_SAIDA/Acessos.txt"
  if [ -s "$PASTA_SAIDA/Acessos.txt" ]; then
    echo -e " ${VERMELHO}❌ REGISTROS DETECTADOS${RESET}"
    cat "$PASTA_SAIDA/Acessos.txt" | sort | uniq
    echo "ACESSOS SUSPEITOS:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Acessos.txt" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ NENHUM ACESSO IRREGULAR${RESET}"
  fi

  echo -e "\n${AZUL}🔬 ARQUIVOS NO SISTEMA${RESET}"
  find /sdcard /data/local/tmp -type f \( -iname "*.apk" -o -iname "*proxy*" -o -iname "*hack*" -o -iname "*cheat*" -o -iname "*mod*ff*" \) -not -path "*/termux/*" -not -path "*/Android/data/com.dts.freefire*" 2>/dev/null > "$PASTA_SAIDA/Arquivos.txt"
  if [ -s "$PASTA_SAIDA/Arquivos.txt" ]; then
    echo -e " ${VERMELHO}❌ ARQUIVOS SUSPEITOS${RESET}"
    cat "$PASTA_SAIDA/Arquivos.txt"
    echo "ARQUIVOS IRREGULARES:" >> "$RELATORIO"
    cat "$PASTA_SAIDA/Arquivos.txt" >> "$RELATORIO"
  else
    echo -e " ${VERDE}✅ SISTEMA LIMPO${RESET}"
  fi

  echo -e "\n${CIANO}========================================${RESET}"
  echo -e "${VERDE}✅ VARREDURA CONCLUÍDA${RESET}"
  echo -e "${BRANCO}📂 Relatório: $RELATORIO${RESET}"
  echo -e "${CIANO}========================================${RESET}"
  sleep 3
}

# ==================================================
# MENU PRINCIPAL
# ==================================================
while true; do
  clear
  echo -e "${CIANO}
   ███████╗ ██████╗  █████╗ ███╗   ██╗███████╗
   ██╔════╝██╔════╝ ██╔══██╗████╗  ██║██╔════╝
   ███████╗██║  ███╗███████║██╔██╗ ██║███████║
   ╚════██║██║   ██║██╔══██║██║╚██╗██║╚════██║
   ███████║╚██████╔╝██║  ██║██║ ╚████║███████║
   ╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝
${RESET}"
  echo -e "${CIANO}Coded By: Sam${RESET}"
  echo -e ""
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"
  echo -e "${AZUL}           MENU PRINCIPAL${RESET}"
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"

  verifica_conexao
  if [ $CONECTADO -eq 1 ]; then
    echo -e "ADB: ${VERDE}● CONECTADO | $DISP${RESET}"
  else
    echo -e "ADB: ${VERMELHO}○ NÃO CONECTADO${RESET}"
  fi
  echo -e ""

  echo -e "${BRANCO}[0] Parear Dispositivo${RESET}"
  if [ $CONECTADO -eq 1 ]; then
    echo -e "${BRANCO}[1] Escanear Free Fire Normal${RESET}"
    echo -e "${BRANCO}[2] Escanear Free Fire MAX${RESET}"
    echo -e "${BRANCO}[3] Varredura Completa${RESET}"
    echo -e "${BRANCO}[4] Salvar Relatório${RESET}"
  else
    echo -e "${BRANCO}[1] Escanear Free Fire Normal ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[2] Escanear Free Fire MAX     ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[3] Varredura Completa          ${VERMELHO}(pareie primeiro)${RESET}"
    echo -e "${BRANCO}[4] Salvar Relatório            ${VERMELHO}(pareie primeiro)${RESET}"
  fi
  echo -e "${BRANCO}[S] Sair${RESET}"
  echo -e "${AZUL}══════════════════════════════════════════════${RESET}"
  echo -e -n "${BRANCO}Escolha: ${RESET}"
  read OP

  case "$OP" in
    0)
      clear
      echo -e "${CIANO}════════════ PAREAMENTO DEPURAÇÃO WI-FI ════════════${RESET}"
      echo -e "${AMARELO}⚠️  PRIMEIRO: Abra > Depuração por Wi‑Fi > Parear com código${RESET}"
      echo -e "${AMARELO}   Mantenha essa tela aberta durante todo o processo!${RESET}"
      echo -e ""
      echo -e "${AMARELO}⚠️  ACEITE A PERMISSÃO na tela do celular${RESET}"
      echo -e -n "   Aperte ENTER quando aceitar: "
      read _
      echo -e ""
      echo -e "${BRANCO}1. PORTA ABAIXO DO CÓDIGO DE PAREAMENTO: ${RESET}"
      read P_PAR
      echo -e "${BRANCO}2. CÓDIGO DE 6 DÍGITOS: ${RESET}"
      read COD
      echo -e "${BRANCO}3. PORTA DO ENDEREÇO IP E PORTA: ${RESET}"
      read P_CON
      echo -e ""

      IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
      if [ -z "$IP" ]; then
        echo -e "${VERMELHO}❌ SEM WI-FI CONECTADO!${RESET}"
        sleep 2
        continue
      fi

      echo -e "${CIANO}🔗 VERIFICANDO DADOS E PAREANDO...${RESET}"
      RES=$(adb pair "$IP:$P_PAR" "$COD" 2>&1)
      if echo "$RES" | grep -qi "successfully\|pareado"; then
        echo -e "${VERDE}✅ CÓDIGO/PORTA CONFIRMADO${RESET}"
      else
        echo -e "${VERMELHO}❌ FALHA: $RES${RESET}"
        echo -e "${AMARELO}Verifique se a tela de pareamento está aberta e os dados corretos${RESET}"
        sleep 3
        continue
      fi

      echo -e "${CIANO}🔌 CONCEDENDO ACESSO TOTAL NA PORTA $P_CON...${RESET}"
      RES_CON=$(adb connect "$IP:$P_CON" 2>&1)
      if echo "$RES_CON" | grep -qi "connected\|conectado"; then
        echo -e "${VERDE}✅ CONEXÃO ESTABELECIDA - ACESSO TOTAL CONFIRMADO${RESET}"
      else
        echo -e "${VERMELHO}❌ NÃO FOI POSSÍVEL LIBERAR ACESSO: $RES_CON${RESET}"
        sleep 3
        continue
      fi

      verifica_conexao
      sleep 2
    ;;

    1|2|3|4)
      if [ $CONECTADO -eq 0 ]; then
        echo -e "\n${VERMELHO}❌ PRIMEIRO PAREE NA OPÇÃO [0]${RESET}"
        sleep 2
        continue
      fi
      iniciar_varredura
    ;;

    S|s)
      clear
      echo -e "${VERDE}✅ Encerrando Scanner By Sam${RESET}"
      adb kill-server >/dev/null 2>&1
      exit 0
    ;;

    *)
      echo -e "\n${VERMELHO}❌ OPÇÃO INVÁLIDA${RESET}"
      sleep 1
    ;;
  esac
done
